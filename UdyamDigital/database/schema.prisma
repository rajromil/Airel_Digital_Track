datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
generator client { provider = "prisma-client-js" }
enum KycStatus { PENDING IN_REVIEW NEEDS_CORRECTION COMPLETED REJECTED }
enum OrderStatus { ORDER_CONFIRMED INSTALLATION_SCHEDULED INSTALLATION_COMPLETED ACTIVATED }
model CatalogueVersion { id String @id @default(uuid()) @db.Uuid; sourceName String; sourceHash String; active Boolean @default(false); importedAt DateTime @default(now()); products Product[]; @@index([active]) }
model Product { id String @id @default(uuid()) @db.Uuid; catalogueVersionId String @db.Uuid; productCode String; name String; description String; category String; unit String; priceMinInr Int; priceMaxInr Int; setupInr Int; minContractMonths Int; minEmployees Int; minSites Int; requiresGstin Boolean; requiresOneOf String[]; targetSegments String[]; availableCityTiers Int[]; typicalInstallDays Int; catalogueVersion CatalogueVersion @relation(fields:[catalogueVersionId], references:[id]); @@unique([catalogueVersionId, productCode]) }
model BusinessProfile { id String @id @default(uuid()) @db.Uuid; businessName String; segment String; cityTier Int; employeeCount Int; siteCount Int; gstinStatus String; createdAt DateTime @default(now()); quotes Quote[]; kycCases KycCase[]; orders Order[] }
model Quote { id String @id @default(uuid()) @db.Uuid; businessId String @db.Uuid; status String; contractMonths Int; monthlyTotalInr Int; setupTotalInr Int; expiresAt DateTime; business BusinessProfile @relation(fields:[businessId], references:[id]); items QuoteItem[]; createdAt DateTime @default(now()) }
model QuoteItem { id String @id @default(uuid()) @db.Uuid; quoteId String @db.Uuid; productCodeSnapshot String; quantity Int; unitMonthlyPriceInr Int; setupUnitPriceInr Int; recurringTotalInr Int; setupTotalInr Int; quote Quote @relation(fields:[quoteId], references:[id]) }
model KycCase { id String @id @default(uuid()) @db.Uuid; businessId String @db.Uuid; status KycStatus @default(PENDING); consent Boolean @default(false); business BusinessProfile @relation(fields:[businessId], references:[id]); orders Order[] }
model Order { id String @id @default(uuid()) @db.Uuid; publicReference String @unique; businessId String @db.Uuid; quoteId String @db.Uuid; kycCaseId String @db.Uuid; status OrderStatus; business BusinessProfile @relation(fields:[businessId], references:[id]); kycCase KycCase @relation(fields:[kycCaseId], references:[id]); createdAt DateTime @default(now()) }
